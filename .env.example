# Telegram (obligatorio para enviar; sin esto usá --dry-run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM (opcional). Sin clave, el resumen se arma con titulares y links.
# Gemini tiene tier gratis (https://aistudio.google.com/apikey) y tiene prioridad.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ajustes
MAX_EVENTS=7
REQUEST_TIMEOUT=20
